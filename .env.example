# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- LLM / embeddings (used from Milestone 2 on) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Embedding model and vector size. The size must match vector(1536) in
# migrations/003_rag_schema.sql; another size needs a new migration.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Model that writes /ask answers (choice explained in README, "Answer results")
# and its effort (low | medium | high | xhigh | max).
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
# Best-chunk similarity below this is answered "off topic" without calling the LLM.
# See evals/results/off_topic_threshold.md.
OFF_TOPIC_MIN_SIMILARITY=0.22

# --- Postgres (read by docker-compose.yml and app/config.py) ---
POSTGRES_USER=analytics
POSTGRES_PASSWORD=
POSTGRES_DB=analytics
# Host and port the app uses to reach the database. Defaults match docker-compose.yml.
# Use 127.0.0.1 rather than localhost: the port is bound to IPv4 only (see app/config.py).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Read-only SQL tool (MCP run_readonly_sql, Milestone 5) ---
# Password of the olist_reader role (migrations/005_readonly_role.sql); app.migrate sets
# it. Use a different random string than POSTGRES_PASSWORD. Empty = the tool is disabled.
READONLY_DB_PASSWORD=
# Rows returned to the model per query, and the time limit per query.
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
