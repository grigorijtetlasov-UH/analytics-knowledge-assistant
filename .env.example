# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- LLM / embeddings (used from Milestone 2 on) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Postgres (read by docker-compose.yml and app/config.py) ---
POSTGRES_USER=analytics
POSTGRES_PASSWORD=
POSTGRES_DB=analytics
# Host and port the app uses to reach the database. Defaults match docker-compose.yml.
# Use 127.0.0.1 rather than localhost: the port is bound to IPv4 only (see app/config.py).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
